{
  "manifest_version": 3,
  "name": "Debrief \u2014 Call Logger",
  "short_name": "Debrief",
  "version": "0.6.0",
  "description": "Log every answered call in two clicks, track breaks, sign off your day and see your stats. For sales and setting teams.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Debrief",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "idle"
  ],
  "host_permissions": [
    "https://oiatnoefkakgoctqgrzz.supabase.co/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "Open Debrief"
    }
  }
}
