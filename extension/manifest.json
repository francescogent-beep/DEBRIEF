{
  "manifest_version": 3,
  "name": "Debrief — Call Logger",
  "short_name": "Debrief",
  "version": "0.1.0",
  "description": "Log every answered call in seconds, see where calls die, and sign off your day.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Debrief",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+D", "mac": "Alt+D" },
      "description": "Open Debrief"
    }
  }
}
